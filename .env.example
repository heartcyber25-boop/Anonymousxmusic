# Telegram application credentials from https://my.telegram.org/apps
API_ID=
API_HASH=

# Bot token from https://t.me/BotFather
BOT_TOKEN=

# Telegram chat/group ID used for startup and error logs
LOGGER_ID=

# MongoDB connection URI, for example from MongoDB Atlas
MONGO_URL=

# Numeric Telegram user ID of the bot owner
OWNER_ID=

# Primary Pyrogram assistant string session
SESSION=

# Optional additional assistant sessions
SESSION2=
SESSION3=

# ROSE MUSIC links (optional; these defaults are already configured)
SUPPORT_CHANNEL=https://t.me/aresxcores
SUPPORT_CHAT=https://t.me/zorolegacy

# Optional playback and runtime settings
DURATION_LIMIT=60
QUEUE_LIMIT=20
PLAYLIST_LIMIT=20
AUTO_LEAVE=False
AUTO_END=False
THUMB_GEN=True
VIDEO_PLAY=True
LANG_CODE=en

# Optional space-separated cookie URLs containing batbin.me
COOKIES_URL=

# Optional image overrides
DEFAULT_THUMB=
PING_IMG=
START_IMG=
